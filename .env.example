# Microsoft Foundry Configuration
FOUNDRY_PROJECT_ENDPOINT=https://warrantycheckai-resource.services.ai.azure.com/api/projects/WarrantyCheckAI
FOUNDRY_AGENT_NAME=WarrantyCheckAI
FOUNDRY_AGENT_VERSION=1

# Azure Service Principal (required for Render / production deployment)
# Create via: az ad sp create-for-rbac --name "WarrantyCheckAI-SP" --role "Azure AI Developer" --scopes /subscriptions/<sub-id>/resourceGroups/<rg>
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=uploads
